{
  "name": "sonic-anthology",
  "version": "1.0.0",
  "description": "Sonic Anthology - unofficial non-commercial fan game",
  "main": "electron/main.js",
  "author": "shelledshock08-wq",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.fangame.sonic-anthology",
    "productName": "Sonic Anthology",
    "directories": { "output": "dist" },
    "files": ["index.html", "js/**", "assets/**", "electron/**", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "SonicEmeraldMeadow.exe" },
    "linux": { "target": "AppImage", "category": "Game" }
  }
}
